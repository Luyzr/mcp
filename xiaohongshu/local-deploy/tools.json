{
  "jsonrpc": "2.0",
  "id": 1,
  "result": {
    "tools": [
      {
        "annotations": {
          "readOnlyHint": true,
          "title": "Check Login Status"
        },
        "description": "检查小红书登录状态",
        "inputSchema": {
          "type": "object"
        },
        "name": "check_login_status"
      },
      {
        "annotations": {
          "destructiveHint": true,
          "title": "Delete Cookies"
        },
        "description": "删除 cookies 文件，重置登录状态。删除后需要重新登录。",
        "inputSchema": {
          "type": "object"
        },
        "name": "delete_cookies"
      },
      {
        "annotations": {
          "destructiveHint": true,
          "title": "Favorite Feed"
        },
        "description": "收藏指定笔记或取消收藏（如已收藏将跳过收藏，如未收藏将跳过取消收藏）",
        "inputSchema": {
          "type": "object",
          "properties": {
            "feed_id": {
              "type": "string",
              "description": "小红书笔记ID，从Feed列表获取"
            },
            "xsec_token": {
              "type": "string",
              "description": "访问令牌，从Feed列表的xsecToken字段获取"
            },
            "unfavorite": {
              "type": "boolean",
              "description": "是否取消收藏，true为取消收藏，false或未设置则为收藏"
            }
          },
          "required": [
            "feed_id",
            "xsec_token"
          ],
          "additionalProperties": false
        },
        "name": "favorite_feed"
      },
      {
        "annotations": {
          "readOnlyHint": true,
          "title": "Get Feed Detail"
        },
        "description": "获取小红书笔记详情，返回笔记内容、图片、作者信息、互动数据（点赞/收藏/分享数）及评论列表。视频笔记额外返回 video 字段，含各编码档位的视频直链与字幕地址（均带签名、有时效）。默认返回前10条一级评论，如需更多评论请设置load_all_comments=true",
        "inputSchema": {
          "type": "object",
          "properties": {
            "feed_id": {
              "type": "string",
              "description": "小红书笔记ID，从Feed列表获取"
            },
            "xsec_token": {
              "type": "string",
              "description": "访问令牌，从Feed列表的xsecToken字段获取"
            },
            "load_all_comments": {
              "type": "boolean",
              "description": "是否加载全部评论。false仅返回前10条一级评论（默认），true滚动加载更多评论"
            },
            "limit": {
              "type": "integer",
              "description": "【仅当load_all_comments为true时生效】限制加载的一级评论数量。例如20表示最多加载20条，默认20"
            },
            "click_more_replies": {
              "type": "boolean",
              "description": "【仅当load_all_comments为true时生效】是否展开二级回复。true展开子评论，false不展开（默认）"
            },
            "reply_limit": {
              "type": "integer",
              "description": "【仅当click_more_replies为true时生效】跳过回复数过多的评论。例如10表示跳过超过10条回复的，默认10"
            },
            "scroll_speed": {
              "type": "string",
              "description": "【仅当load_all_comments为true时生效】滚动速度slow慢速、normal正常、fast快速"
            }
          },
          "required": [
            "feed_id",
            "xsec_token"
          ],
          "additionalProperties": false
        },
        "name": "get_feed_detail"
      },
      {
        "annotations": {
          "readOnlyHint": true,
          "title": "Get Login QR Code"
        },
        "description": "获取登录二维码（返回 Base64 图片和超时时间）",
        "inputSchema": {
          "type": "object"
        },
        "name": "get_login_qrcode"
      },
      {
        "annotations": {
          "readOnlyHint": true,
          "title": "Get My Profile"
        },
        "description": "获取当前登录用户的主页，返回用户基本信息，关注、粉丝、获赞量，以及指定 tab 下的内容。tab 可选 note(自己发的笔记,默认)、fav(自己收藏的)、liked(自己点赞的)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "tab": {
              "type": "string",
              "description": "主页 tab: note(笔记,默认)|fav(收藏)|liked(点赞)"
            }
          },
          "additionalProperties": false
        },
        "name": "get_my_profile"
      },
      {
        "annotations": {
          "readOnlyHint": true,
          "title": "Get Unread Count"
        },
        "description": "获取通知未读数，返回「评论和@」「赞和收藏」「新增关注」三个分区各自的未读条数。不会清除未读标记。查看具体内容用 list_notifications。",
        "inputSchema": {
          "type": "object"
        },
        "name": "get_unread_count"
      },
      {
        "annotations": {
          "destructiveHint": true,
          "title": "Like Feed"
        },
        "description": "为指定笔记点赞或取消点赞（如已点赞将跳过点赞，如未点赞将跳过取消点赞）",
        "inputSchema": {
          "type": "object",
          "properties": {
            "feed_id": {
              "type": "string",
              "description": "小红书笔记ID，从Feed列表获取"
            },
            "xsec_token": {
              "type": "string",
              "description": "访问令牌，从Feed列表的xsecToken字段获取"
            },
            "unlike": {
              "type": "boolean",
              "description": "是否取消点赞，true为取消点赞，false或未设置则为点赞"
            }
          },
          "required": [
            "feed_id",
            "xsec_token"
          ],
          "additionalProperties": false
        },
        "name": "like_feed"
      },
      {
        "annotations": {
          "destructiveHint": true,
          "title": "Like Notification"
        },
        "description": "给「评论和@」里的一条评论点赞或取消点赞。comment_id 从 list_notifications 获取（其 liked 字段是当前状态）。已是目标状态时跳过。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "comment_id": {
              "type": "string",
              "description": "目标评论ID，从 list_notifications 的 comment_id 字段获取"
            },
            "unlike": {
              "type": "boolean",
              "description": "是否取消点赞，true为取消点赞，false或未设置则为点赞"
            }
          },
          "required": [
            "comment_id"
          ],
          "additionalProperties": false
        },
        "name": "like_notification"
      },
      {
        "annotations": {
          "readOnlyHint": true,
          "title": "List Feeds"
        },
        "description": "获取首页 Feeds 列表",
        "inputSchema": {
          "type": "object"
        },
        "name": "list_feeds"
      },
      {
        "annotations": {
          "readOnlyHint": true,
          "title": "List Notifications"
        },
        "description": "获取通知列表。返回评论内容、评论者、以及对应笔记的 feed_id 和 xsec_token（可用于 get_feed_detail 读原帖）。已删除或不可见的条目会被过滤，过滤数量见 filtered 字段。注意：会清除该分区的未读标记，只需要未读数时用 get_unread_count。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "tab": {
              "type": "string",
              "description": "通知分区: mentions(评论和@,默认)|likes(赞和收藏)|connections(新增关注)"
            },
            "limit": {
              "type": "integer",
              "description": "返回条数上限，默认20"
            }
          },
          "additionalProperties": false
        },
        "name": "list_notifications"
      },
      {
        "annotations": {
          "destructiveHint": true,
          "title": "Post Comment"
        },
        "description": "发表评论到小红书笔记",
        "inputSchema": {
          "type": "object",
          "properties": {
            "feed_id": {
              "type": "string",
              "description": "小红书笔记ID，从Feed列表获取"
            },
            "xsec_token": {
              "type": "string",
              "description": "访问令牌，从Feed列表的xsecToken字段获取"
            },
            "content": {
              "type": "string",
              "description": "评论内容"
            }
          },
          "required": [
            "feed_id",
            "xsec_token",
            "content"
          ],
          "additionalProperties": false
        },
        "name": "post_comment_to_feed"
      },
      {
        "annotations": {
          "destructiveHint": true,
          "title": "Publish Content"
        },
        "description": "发布小红书图文内容",
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "内容标题（小红书限制：最多20个中文字或英文单词）"
            },
            "content": {
              "type": "string",
              "description": "正文内容，不包含以#开头的标签内容，所有话题标签都用tags参数来生成和提供即可"
            },
            "images": {
              "type": [
                "null",
                "array"
              ],
              "items": {
                "type": "string"
              },
              "description": "图片路径列表（至少需要1张图片）。支持两种方式：1. HTTP/HTTPS图片链接（自动下载）；2. 本地图片绝对路径（推荐，如:/Users/user/image.jpg）"
            },
            "tags": {
              "type": [
                "null",
                "array"
              ],
              "items": {
                "type": "string"
              },
              "description": "话题标签列表（可选参数），如 [美食, 旅行, 生活]"
            },
            "schedule_at": {
              "type": "string",
              "description": "定时发布时间（可选），ISO8601格式如 2024-01-20T10:30:00+08:00，支持1小时至14天内。不填则立即发布"
            },
            "is_original": {
              "type": "boolean",
              "description": "是否声明原创（可选），true为声明原创，false或不填则不声明"
            },
            "visibility": {
              "type": "string",
              "description": "可见范围（可选），支持: 公开可见(默认)、仅自己可见、仅互关好友可见。不填则默认公开可见"
            },
            "products": {
              "type": [
                "null",
                "array"
              ],
              "items": {
                "type": "string"
              },
              "description": "商品关键词列表（可选），用于绑定带货商品。填写商品名称或商品ID，系统会自动搜索并选择第一个匹配结果。需账号已开通商品功能。示例: [面膜, 防晒霜SPF50]"
            }
          },
          "required": [
            "title",
            "content",
            "images"
          ],
          "additionalProperties": false
        },
        "name": "publish_content"
      },
      {
        "annotations": {
          "destructiveHint": true,
          "title": "Publish Video"
        },
        "description": "发布小红书视频内容（仅支持本地单个视频文件）",
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "内容标题（小红书限制：最多20个中文字或英文单词）"
            },
            "content": {
              "type": "string",
              "description": "正文内容，不包含以#开头的标签内容，所有话题标签都用tags参数来生成和提供即可"
            },
            "video": {
              "type": "string",
              "description": "本地视频绝对路径（仅支持单个视频文件，如:/Users/user/video.mp4）"
            },
            "tags": {
              "type": [
                "null",
                "array"
              ],
              "items": {
                "type": "string"
              },
              "description": "话题标签列表（可选参数），如 [美食, 旅行, 生活]"
            },
            "schedule_at": {
              "type": "string",
              "description": "定时发布时间（可选），ISO8601格式如 2024-01-20T10:30:00+08:00，支持1小时至14天内。不填则立即发布"
            },
            "visibility": {
              "type": "string",
              "description": "可见范围（可选），支持: 公开可见(默认)、仅自己可见、仅互关好友可见。不填则默认公开可见"
            },
            "products": {
              "type": [
                "null",
                "array"
              ],
              "items": {
                "type": "string"
              },
              "description": "商品关键词列表（可选），用于绑定带货商品。填写商品名称或商品ID，系统会自动搜索并选择第一个匹配结果。需账号已开通商品功能。示例: [面膜, 防晒霜SPF50]"
            }
          },
          "required": [
            "title",
            "content",
            "video"
          ],
          "additionalProperties": false
        },
        "name": "publish_with_video"
      },
      {
        "annotations": {
          "destructiveHint": true,
          "title": "Reply Comment"
        },
        "description": "回复小红书笔记下的指定评论",
        "inputSchema": {
          "type": "object",
          "properties": {
            "feed_id": {
              "type": "string",
              "description": "小红书笔记ID，从Feed列表获取"
            },
            "xsec_token": {
              "type": "string",
              "description": "访问令牌，从Feed列表的xsecToken字段获取"
            },
            "comment_id": {
              "type": "string",
              "description": "目标评论ID，从评论列表获取"
            },
            "user_id": {
              "type": "string",
              "description": "目标评论用户ID，从评论列表获取"
            },
            "content": {
              "type": "string",
              "description": "回复内容"
            }
          },
          "required": [
            "feed_id",
            "xsec_token",
            "content"
          ],
          "additionalProperties": false
        },
        "name": "reply_comment_in_feed"
      },
      {
        "annotations": {
          "destructiveHint": true,
          "title": "Reply Notification"
        },
        "description": "回复「评论和@」里的一条评论。comment_id 从 list_notifications 获取。适合处理收到的评论，无需先定位笔记。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "comment_id": {
              "type": "string",
              "description": "目标评论ID，从 list_notifications 的 comment_id 字段获取"
            },
            "content": {
              "type": "string",
              "description": "回复内容"
            }
          },
          "required": [
            "comment_id",
            "content"
          ],
          "additionalProperties": false
        },
        "name": "reply_notification"
      },
      {
        "annotations": {
          "readOnlyHint": true,
          "title": "Search Feeds"
        },
        "description": "搜索小红书内容（需要已登录）",
        "inputSchema": {
          "type": "object",
          "properties": {
            "keyword": {
              "type": "string",
              "description": "搜索关键词"
            },
            "filters": {
              "type": "object",
              "properties": {
                "sort_by": {
                  "type": "string",
                  "description": "排序依据: 综合|最新|最多点赞|最多评论|最多收藏,默认为'综合'"
                },
                "note_type": {
                  "type": "string",
                  "description": "笔记类型: 不限|视频|图文,默认为'不限'"
                },
                "publish_time": {
                  "type": "string",
                  "description": "发布时间: 不限|一天内|一周内|半年内,默认为'不限'"
                },
                "search_scope": {
                  "type": "string",
                  "description": "搜索范围: 不限|已看过|未看过|已关注,默认为'不限'"
                },
                "location": {
                  "type": "string",
                  "description": "位置距离: 不限|同城|附近,默认为'不限'"
                }
              },
              "description": "筛选选项",
              "additionalProperties": false
            }
          },
          "required": [
            "keyword"
          ],
          "additionalProperties": false
        },
        "name": "search_feeds"
      },
      {
        "annotations": {
          "readOnlyHint": true,
          "title": "User Profile"
        },
        "description": "获取指定的小红书用户主页，返回用户基本信息，关注、粉丝、获赞量，以及指定 tab 下的内容。tab 可选 note(笔记,默认)、fav(收藏)、liked(点赞)，后两者可能被对方设为不公开",
        "inputSchema": {
          "type": "object",
          "properties": {
            "user_id": {
              "type": "string",
              "description": "小红书用户ID，从Feed列表获取"
            },
            "xsec_token": {
              "type": "string",
              "description": "访问令牌，从Feed列表的xsecToken字段获取"
            },
            "tab": {
              "type": "string",
              "description": "主页 tab: note(笔记,默认)|fav(收藏)|liked(点赞)。收藏和点赞可能被对方设为不公开"
            }
          },
          "required": [
            "user_id",
            "xsec_token"
          ],
          "additionalProperties": false
        },
        "name": "user_profile"
      }
    ]
  }
}
