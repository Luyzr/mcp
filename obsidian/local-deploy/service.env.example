VAULT_PATH=/data/obsidian_library
TRANSPORT=http
HOST=127.0.0.1
PORT=18076
READ_ONLY=false
WRITE_PATHS=
DENY_READ_PATHS=.git/,.obsidian/,.trash/
DENY_WRITE_PATHS=.git/,.obsidian/,.trash/,_AI_INSTRUCTIONS.md,.gitignore,.gitattributes,.gitmodules
EXCLUDE_PATHS=.git/,.obsidian/,.trash/
ALLOW_PERMANENT_DELETE=false
REQUIRE_WRITE_PRECONDITIONS=true
LOCK_PATH=/var/lib/obsidian-mcp/locks
AUDIT_LOG_PATH=/var/lib/obsidian-mcp/audit.jsonl
FASTMCP_HOME=/var/lib/obsidian-mcp/fastmcp
ENABLE_CANVAS=true
ENABLE_EXCALIDRAW=true
ENABLE_KANBAN=true
ENABLE_BASES=true
API_KEY=REPLACE_WITH_RANDOM_SECRET
